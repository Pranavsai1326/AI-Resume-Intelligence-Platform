# AI Resume Intelligence Platform — example environment
# Copy to backend/.env and fill in. NEVER commit a real .env file.
# Variable names only below; no real credentials belong in this file.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development                 # development | staging | production
DEBUG=true                          # must be false in production
HOST=127.0.0.1
PORT=8000
WORKERS=1                           # >1 requires SESSION_STORE_BACKEND=redis

# ---------------------------------------------------------------------------
# CORS — explicit allowlist. Wildcard is rejected at startup in production.
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Session store
#   memory = single-process, no infrastructure required (development default)
#   redis  = required for multi-worker / multi-instance production
# ---------------------------------------------------------------------------
SESSION_STORE_BACKEND=memory
REDIS_URL=                          # e.g. redis://localhost:6379/0 (required when backend=redis)

# ---------------------------------------------------------------------------
# Session lifetime
# ---------------------------------------------------------------------------
SESSION_IDLE_TTL_SECONDS=3600       # 60 minutes, refreshed on activity
SESSION_ABSOLUTE_TTL_SECONDS=28800  # 8 hours, never extended
JANITOR_INTERVAL_SECONDS=60

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_SESSION_CREATE_PER_HOUR=30
RATE_LIMIT_REQUESTS_PER_MINUTE=120

# ---------------------------------------------------------------------------
# Uploads (Phase 2)
# ---------------------------------------------------------------------------
MAX_UPLOAD_BYTES=10485760           # 10 MB
MAX_PDF_PAGES=20
MAX_BULK_RESUMES=100
TEMP_DIR=                           # blank = OS temp dir, created with 0700

# ---------------------------------------------------------------------------
# AI providers — NOT required for Phases 1-4.
#   LLM_PROVIDER=null  -> honest "AI unavailable" state, no fabricated output
# ---------------------------------------------------------------------------
LLM_PROVIDER=null                   # null | anthropic
ANTHROPIC_API_KEY=                  # server-side only; never exposed to the frontend
LLM_MODEL_REASONING=claude-sonnet-5
LLM_MODEL_BULK=claude-haiku-4-5-20251001
LLM_TIMEOUT_SECONDS=60

EMBEDDING_BACKEND=none              # none | fastembed | remote   (Phase 4)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ---------------------------------------------------------------------------
# Document processing (Phase 2)
# ---------------------------------------------------------------------------
OCR_ENABLED=false                   # requires the Tesseract binary on PATH
TESSERACT_CMD=

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=console                  # console (dev) | json (production)

# ---------------------------------------------------------------------------
# Frontend (frontend/.env.local)
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
