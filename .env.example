# AI Resume Intelligence Platform — example environment
# Copy to backend/.env and fill in. NEVER commit a real .env file.
# Variable names only below; no real credentials belong in this file.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development                 # development | staging | production
DEBUG=true                          # must be false in production
HOST=127.0.0.1
PORT=8000
WORKERS=1                           # >1 requires SESSION_STORE_BACKEND=redis

# ---------------------------------------------------------------------------
# CORS — explicit allowlist. Wildcard is rejected at startup in production.
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Session store
#   memory = single-process, no infrastructure required (development default)
#   redis  = required for multi-worker / multi-instance production
# ---------------------------------------------------------------------------
SESSION_STORE_BACKEND=memory
REDIS_URL=                          # e.g. redis://localhost:6379/0 (required when backend=redis)

# ---------------------------------------------------------------------------
# Session lifetime
# ---------------------------------------------------------------------------
SESSION_IDLE_TTL_SECONDS=3600       # 60 minutes, refreshed on activity
SESSION_ABSOLUTE_TTL_SECONDS=28800  # 8 hours, never extended
JANITOR_INTERVAL_SECONDS=60

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_SESSION_CREATE_PER_HOUR=30
RATE_LIMIT_REQUESTS_PER_MINUTE=120
RATE_LIMIT_AI_CALLS_PER_HOUR=100
RATE_LIMIT_EXPORTS_PER_HOUR=60
# Session-lifetime cap on total AI tokens spent (Phase 9G) - bounds spend even when every
# individual call stays under the hourly limit above.
RATE_LIMIT_AI_TOKENS_PER_SESSION=200000

# ---------------------------------------------------------------------------
# Uploads (Phase 2)
# ---------------------------------------------------------------------------
MAX_UPLOAD_BYTES=10485760           # 10 MB
MAX_PDF_PAGES=20
MAX_BULK_RESUMES=100
TEMP_DIR=                           # blank = OS temp dir, created with 0700

# ---------------------------------------------------------------------------
# AI providers.
#   LLM_PROVIDER=null       -> honest "AI unavailable" state, no fabricated output. Not needed
#                              until Phase 5 (resume builder writing features).
#   LLM_PROVIDER=gemini     -> Google Gemini via the official GenAI SDK (Phase 9F), behind the
#                              same LLMProvider abstraction as every other provider. The value
#                              below is a DUMMY PLACEHOLDER - the app detects it (and other
#                              obvious placeholders) and reports the provider honestly
#                              unavailable rather than attempting a real request with it. Replace
#                              GEMINI_API_KEY with a real key and restart the backend; no code
#                              change is needed.
#   EMBEDDING_BACKEND=fastembed -> local ONNX model (ADR-0005), no API key, nothing leaves the
#                              server. Downloads ~130MB to a local cache on first use. Powers
#                              Phase 4's semantic matching; set to "none" to disable.
# ---------------------------------------------------------------------------
LLM_PROVIDER=null                   # null | anthropic | gemini
ANTHROPIC_API_KEY=                  # server-side only; never exposed to the frontend
LLM_MODEL_REASONING=claude-sonnet-5
LLM_MODEL_BULK=claude-haiku-4-5-20251001

GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE   # DUMMY PLACEHOLDER - replace with a real key, never commit it
LLM_MODEL_GEMINI=gemini-2.5-flash         # a current, low-cost/free-tier-friendly Flash model

LLM_TIMEOUT_SECONDS=60

EMBEDDING_BACKEND=fastembed          # none | fastembed | remote
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ---------------------------------------------------------------------------
# Document processing (Phase 2)
# ---------------------------------------------------------------------------
OCR_ENABLED=false                   # requires the Tesseract binary on PATH
TESSERACT_CMD=

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=console                  # console (dev) | json (production)

# ---------------------------------------------------------------------------
# Frontend (frontend/.env.local)
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
